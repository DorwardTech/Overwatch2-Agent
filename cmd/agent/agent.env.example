# Overwatch Site Agent - configuration
#
# One KEY=VALUE per line. Lines starting with # are comments. A value may be
# wrapped in quotes; nothing else is interpreted, so Windows paths are written
# as they are. A setting already present in the process environment takes
# precedence over this file.
#
# This file holds the site's token: keep it readable by administrators and the
# agent's service account only (the installer sets that up).
#
# You do not have to edit this by hand: on Windows, open "Overwatch Agent Setup"
# from the Start Menu (or run `overwatch-agent setup`) for a form that fills it
# in, tests the connections, and starts the agent.
#
# Full reference: README.md (every setting) and WINDOWS.md (Windows service).

# --- Required ---------------------------------------------------------------
# The central ingest endpoint.
CENTRAL_API_URL=https://ow2.lasertag.net.au/api/agent/ingest
# This venue's agent token (Overwatch -> Sites -> edit the site -> Generate token).
AGENT_TOKEN=OW2_replace_me

# --- Game server connection -------------------------------------------------
# The venue's game server. 127.0.0.1 when the agent runs on that same machine;
# otherwise its LAN IP address.
OZONE_WS_HOST=127.0.0.1
OZONE_WS_PORT=12113

# --- Post-game results (optional) -------------------------------------------
# Needs the scoresheet-printing licence (results API on port 12123).
ENABLE_GAME_RESULTS=true
OZONE_RESULTS_PORT=12123

# --- Print-server cache + transparent proxy (optional, opt-in) --------------
# Caches finished games while idle and serves them to TORN from the cache.
# ENABLE_CACHE=true
# ENABLE_PROXY=true
# ENABLE_MSG_BUS=true
# On the game server PC itself port 12123 belongs to the real print server, so
# the proxy must listen elsewhere; point TORN at this machine and this port.
# PROXY_LISTEN_ADDR=0.0.0.0:12124
# Browser control panel + JSON API (both settings required to enable it).
# ADMIN_API_ADDR=127.0.0.1:8097
# ADMIN_API_TOKEN=change_me

# --- Tuning -----------------------------------------------------------------
# POLL_INTERVAL=5            # pack poll rate (s) while a game is active
# IDLE_POLL_INTERVAL=15      # pack poll rate (s) when idle; keep under 30
# SLOW_POLL_INTERVAL=60      # teams / games / licences / self-report cadence (s)
# HEALTH_ADDR=127.0.0.1:8088 # health endpoint (default :8088, all interfaces)

# --- Locations --------------------------------------------------------------
# All default to the data directory (Windows: C:\ProgramData\Overwatch Agent).
# CACHE_DIR=
# BUFFER_FILE=
# LOG_FILE=
