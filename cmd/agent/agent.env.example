# Overwatch Site Agent - configuration
#
# One KEY=VALUE per line. Lines starting with # are comments. A value may be
# wrapped in quotes; nothing else is interpreted, so Windows paths are written
# as they are. A setting already present in the process environment takes
# precedence over this file.
#
# This file holds the site's token: keep it readable by administrators and the
# agent's service account only (the installer sets that up).
#
# You do not have to edit this by hand: on Windows, open "Overwatch Agent Setup"
# from the Start Menu (or run `overwatch-agent setup`) for a form that fills it
# in, tests the connections, and starts the agent.
#
# Full reference: README.md (every setting) and WINDOWS.md (Windows service).

# --- Required ---------------------------------------------------------------
# The central ingest endpoint.
CENTRAL_API_URL=https://ow2.lasertag.net.au/api/agent/ingest
# This venue's agent token (Overwatch -> Sites -> edit the site -> Generate token).
AGENT_TOKEN=OW2_replace_me

# --- Which system this venue runs -------------------------------------------
# "ozone" (the default) reads live play from the O-Zone game server, using the
# settings below it. "legacy" reads a Nexus venue instead, using the two
# settings in the legacy section further down; the O-Zone, results and cache
# settings are ignored in that mode.
AGENT_MODE=ozone

# --- Game server connection (ozone mode) ------------------------------------
# The venue's game server, by its LAN IP address. It is a separate appliance
# and the agent never runs on it, so replace the placeholder 127.0.0.1 (which
# is this computer) with its address, or use auto below.
OZONE_WS_HOST=127.0.0.1
OZONE_WS_PORT=12113
#
# Or let the agent find the game server by itself: with OZONE_WS_HOST=auto it
# listens for the announcement the server broadcasts on the venue network
# (UDP 12106) and connects to the address announced. It never guesses: with
# more than one server on the network it waits until OZONE_SID and
# OZONE_ARENA narrow it to one. The setup page's "Find O-Zone on the network"
# button shows both, and so does `overwatch-agent discover`. Without them, the
# one server heard is used for that run only.
# OZONE_WS_HOST=auto
# OZONE_SID=4242             # site id, as announced (auto mode only)
# OZONE_ARENA=1              # arena number, exactly as announced (auto mode only)
#
# With a fixed address the agent still listens for the announcement, only to
# report what it hears; it never changes the address. false opens no socket.
# ENABLE_LIB_LISTENER=true
# OZONE_LIB_PORT=12106       # the installer's firewall rule covers 12106 only

# --- Nexus venue (legacy mode) ----------------------------------------------
# Both are required when AGENT_MODE=legacy, and ignored otherwise.
# The Nexus database, as a Go MySQL DSN. A read-only account is enough, and is
# what this should be: the agent never writes to Nexus.
# NEXUS_DSN=ow2ro:password@tcp(127.0.0.1:3306)/ng_system
# The on-box management app, at the folder it lives in - no trailing slash.
# LASERTAG_URL=http://127.0.0.1/lasertag
# How often to collect finished games from Nexus (s).
# GAME_SYNC_INTERVAL=30

# --- Post-game results (optional, ozone mode) -------------------------------
# Needs a print server on the game server (the scoresheet-printing licence,
# results API on port 12123). A venue whose game server has none should set
# this to false and leave the cache and message bus below off too. If they are
# left on, the agent notices that nothing answers and stops trying except for
# a check between games (see PRINT_SERVER_ABSENT_AFTER below).
ENABLE_GAME_RESULTS=true
OZONE_RESULTS_PORT=12123
#
# After this many failed connections to the print server in a row, spread over
# at least 10 minutes, it is treated as absent: results and cache refresh
# pause, and it is checked again between games, at most every
# PRINT_SERVER_RECHECK_MAX seconds (60-3600). 0 turns this off.
# PRINT_SERVER_ABSENT_AFTER=3
# PRINT_SERVER_RECHECK_MAX=900

# --- Print-server cache + transparent proxy (optional, opt-in, ozone mode) --
# Caches finished games while idle and serves them to TORN from the cache.
# Needs a print server on the game server, like the results above.
# ENABLE_CACHE=true
# ENABLE_PROXY=true
# ENABLE_MSG_BUS=true
# The proxy listens on this computer (the agent's), port 12123 by default:
# point TORN at this computer's LAN address. If another program here already
# uses 12123, give the proxy another port and point TORN at that.
# PROXY_LISTEN_ADDR=0.0.0.0:12124
# Browser control panel + JSON API (both settings required to enable it).
# ADMIN_API_ADDR=127.0.0.1:8097
# ADMIN_API_TOKEN=change_me

# --- Tuning -----------------------------------------------------------------
# POLL_INTERVAL=5            # pack poll rate (s) while a game is active
# IDLE_POLL_INTERVAL=15      # pack poll rate (s) when idle; keep under 30
# SLOW_POLL_INTERVAL=60      # teams / games / licences / self-report cadence (s)
# HEALTH_ADDR=127.0.0.1:8088 # health endpoint (default :8088, all interfaces)

# --- Locations --------------------------------------------------------------
# All default to the data directory (Windows: C:\ProgramData\Overwatch Agent).
# CACHE_DIR=
# BUFFER_FILE=
# LOG_FILE=
